# For `npm run server`: the settings, and the agents' ACCOUNT ids, but no private keys.
#
#   npm run split-env                         # writes this file for you from .env.generated; or copy this one and fill it in by hand
#   DOTENV_CONFIG_PATH=.env.server npm run server
#
# The server only reads the chain. It needs to know which accounts are the agents (to show the swarm panel) and nothing that lets it
# sign for them, so keep the *_PRIVATE_KEY lines from .env.generated in a separate file (.env.agents) used only by `npm run agents`:
#
#   DOTENV_CONFIG_PATH=.env.agents npm run agents
#
# Demo controls (DEMO_*) are the one exception, and they are off unless you turn them on.
NEAR_NETWORK=testnet
VERITY_CONTRACT=
RESEARCHER_ACCOUNT_ID=
SKEPTIC_ACCOUNT_ID=
ARBITER_ACCOUNT_ID=
PORT=8787
# VERITY_USER_AGENT="VerityBot/1.0 (your contact here)"
# TRUST_PROXY=1
# VERITY_ARTICLES=pluto,mount-everest
# VERITY_MAX_ARTICLES=24
# VERITY_POLL_MS=3000
# VERITY_VERIFY_HOSTS=wikipedia.org

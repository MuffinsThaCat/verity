# ── network ────────────────────────────────────────────────
NEAR_NETWORK=testnet                 # testnet | mainnet
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
VERITY_CONTRACT=verity-demo.testnet  # the account you deployed verity.wasm to

# ── the judge ──────────────────────────────────────────────
# Either an Anthropic key ...
ANTHROPIC_API_KEY=
# VERITY_MODEL=claude-sonnet-5-5
# ... or any OpenAI-compatible chat endpoint (for example a NEAR AI Cloud deployment, or a local server)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# VERITY_LLM=off                     # disable the model entirely
# VERITY_MOCK=1                      # offline rule-based judge + tiny static corpus (labelled MOCK in the UI)
# VERITY_USER_AGENT="VerityBot/1.0 (your contact here)"   # Wikimedia asks for a real contact
# VERITY_CACHE_DIR=data/cache        # pinned Wikipedia revisions are kept here (they never change), searches for 6 hours
# VERITY_CACHE_ONLY=1                # answer from the cache alone, no network (run `npm run warm` first)
# VERITY_MIN_REVISION_AGE_HOURS=24   # read the newest Wikipedia revision at least this old (0 = latest); a fresh vandal's edit is not cited
# VERITY_WIKI_GAP_MS=350             # pause between Wikipedia requests; every agent shares one limiter
# VERITY_VERIFY_HOSTS=wikipedia.org  # hosts the server will refetch to verify evidence; keep it short

# ── agent accounts (each is its own NEAR account with its own key) ──
# Use this file for `npm run agents` (as .env.agents). The server should get .env.server.example instead: account ids, no keys.
RESEARCHER_ACCOUNT_ID=
RESEARCHER_PRIVATE_KEY=
SKEPTIC_ACCOUNT_ID=
SKEPTIC_PRIVATE_KEY=
ARBITER_ACCOUNT_ID=
ARBITER_PRIVATE_KEY=
# AGENT_TOPICS=pluto                 # limit agents to some topics
# AGENT_MAX_TRADE_NEAR=1             # each agent's own per-trade spending cap
# AGENT_INTERVAL_MS=15000

# ── server ─────────────────────────────────────────────────
PORT=8787
# ACTIVITY_LOG=data/activity.jsonl
# DATA_DIR=data
# TRUST_PROXY=1                      # behind your own reverse proxy: count visitors by X-Forwarded-For
# VERITY_ARTICLES=pluto,mount-everest   # articles the server and the agents follow; default: the first VERITY_MAX_ARTICLES created
# VERITY_MAX_ARTICLES=24
# VERITY_POLL_MS=3000                # how often the server looks at the chain
# VERITY_FULL_REFRESH_MS=10000       # re-read every article at least this often even if nothing moved (0 = every poll)
# VERITY_SOURCES=wikipedia           # the label the header shows for the evidence source

# ── deployment: npm run bootstrap, then npm run seed ───────
# ADMIN_ACCOUNT_ID=you.testnet       # the funded account that pays for everything
# ADMIN_PRIVATE_KEY=ed25519:...
# PREFIX=verity1                     # a fresh name for the accounts bootstrap creates
# BOND_WINDOW_SECS=3600              # how long an evidence bond stays open before anyone may settle it (fixed at deployment)
# FEE_BPS=100                        # trading fee in basis points: 100 = 1%, at most 300 (fixed at deployment)
# AGENT_FUND_NEAR=10                 # NEAR for each agent account
# EDITOR_FUND_NEAR=60                # NEAR for the account that seeds the articles
# CONTRACT_FUND_NEAR=6               # NEAR for the contract account
# SEED_NEAR=1                        # npm run seed: pool depth per claim, in NEAR

# ── other knobs ────────────────────────────────────────────
# ANTHROPIC_BASE_URL=                # send Anthropic requests somewhere other than api.anthropic.com
# SEED_DIR=seed                      # npm run warm: which seed files to fetch pages for
# SOURCES_PER_CLAIM=4                # npm run warm: must match the agents' sourcesPerClaim (the demo uses 4) or the cache will miss
# DIR_TO_DOWNLOAD_BINARY=            # demo / measure:scan: where near-sandbox keeps its node binary

# ── demo controls ("lie to the encyclopedia") ──────────────
# Leave OFF on a public deployment unless the account is a throwaway:
# DEMO_ENABLED=1
# DEMO_HOURLY_BUDGET_NEAR=150        # most the shared demo account may spend per hour
# DEMO_ACCOUNT_ID=
# DEMO_PRIVATE_KEY=
